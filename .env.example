# AI-OSM Environment Configuration
# Pure Local AI Architecture: Powered by Ollama Local LLMs (Llama 3, Mistral, Qwen)

# Ollama Server Endpoint URL (Default: http://localhost:11434)
OLLAMA_BASE_URL=http://localhost:11434

# Active Ollama Model Tag (e.g., llama3, mistral, qwen2.5, phi3)
OLLAMA_MODEL=llama3

# Database Connection URL (Optional - defaults to SQLite fallback automatically)
DATABASE_URL=mysql+pymysql://root:password@localhost:3306/ai_osm
